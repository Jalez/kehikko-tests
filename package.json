{
  "name": "kehikko-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "How a project is tested, kept as named suites an agent configures over MCP; running one of them under a bound; and what was run against a merge request or a pull request. An app: its own store, its own page, its own port. A host may frame it, and then it learns which reference the canvas has picked out.",
  "scripts": {
    "dev": "vite",
    "build": "bun run build.ts",
    "start": "bun run serve.ts",
    "register": "bun run register.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "roadmap-module-protocol": "git+ssh://git@github.com/Jalez/kehikko-protocol.git#main",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^7.2.4"
  }
}
